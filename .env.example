# ===== Variables para docker compose (todo el proyecto) =====
# Para correr sin Docker usa backend/.env.example y frontend/.env.example

APP_ENV=development
# URL(s) del frontend permitidas por CORS (separadas por coma)
FRONTEND_URL=http://localhost:5173

# Supabase > Project Settings > API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Llave "service_role" / "secret". SOLO en el backend, nunca en el frontend ni en GitHub
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: solo si tu proyecto usa la llave JWT "Legacy JWT secret" (HS256)
# Supabase > Project Settings > JWT Keys. Si usas las llaves nuevas, déjalo vacío.
SUPABASE_JWT_SECRET=

# "supabase" (producción) o "memory" (pruebas sin base de datos)
DATA_BACKEND=supabase

# Agente: "mock" mientras la Persona 1 termina, "real" cuando exista agents/graph.py
AGENT_MODE=mock
AGENT_MODULE=agents.graph
HISTORY_WINDOW=6

# Documentos
MAX_UPLOAD_MB=15
ALLOWED_EXTENSIONS=.pdf,.txt,.md,.csv,.docx

# ===== Agente (Persona 1) =====
# Ollama corre en el PC de una de nosotras, expuesto con ngrok y protegido con usuario y contraseña.
# En local (sin ngrok): http://localhost:11434 y deja usuario y contraseña vacíos.
OLLAMA_URL=https://TU-DOMINIO.ngrok-free.app
OLLAMA_USER=
OLLAMA_PASS=
OLLAMA_MODEL=qwen2.5:3b
EMBEDDING_MODEL=bge-m3

# pgvector en Supabase. Usa la cadena del "Session pooler" (Render no tiene IPv6)
# y cambia el prefijo postgresql:// por postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://postgres.TU-PROYECTO:CONTRASEÑA@aws-0-REGION.pooler.supabase.com:5432/postgres

# ===== Frontend =====
# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Llave pública "anon" / "publishable" (es seguro exponerla en el navegador)
VITE_SUPABASE_ANON_KEY=
