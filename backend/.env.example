# ===== Backend: copia este archivo como .env y llena los valores =====

APP_ENV=development
# URL(s) del frontend permitidas por CORS (separadas por coma)
FRONTEND_URL=http://localhost:5173

# Supabase > Project Settings > API
SUPABASE_URL=https://ndyfurszxacgzpaixxny.supabase.co
# Llave "service_role" / "secret". SOLO en el backend, nunca en el frontend ni en GitHub
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: solo si tu proyecto usa la llave JWT "Legacy JWT secret" (HS256)
# Supabase > Project Settings > JWT Keys. Si usas las llaves nuevas, déjalo vacío.
SUPABASE_JWT_SECRET=

# "supabase" (producción) o "memory" (pruebas sin base de datos)
DATA_BACKEND=supabase

# Agente: "real" usa agents/ y vectorstore/; "mock" es un agente simulado para probar la interfaz
AGENT_MODE=real
HISTORY_WINDOW=6

# Documentos
MAX_UPLOAD_MB=15
ALLOWED_EXTENSIONS=.pdf,.txt,.md,.csv,.docx

# ===== Agente (Persona 1) =====
# Ollama corre en el PC de una de nosotras, expuesto con ngrok y protegido con usuario y contraseña.
# En local (sin ngrok): http://localhost:11434 y deja usuario y contraseña vacíos.
OLLAMA_URL=http://localhost:11434
OLLAMA_USER=
OLLAMA_PASS=
LLM_MODEL=qwen2.5:3b
EMBED_MODEL=bge-m3

# pgvector en Supabase (el MISMO proyecto donde está cargado el corpus).
# Usa la cadena del "Session pooler" (Render no tiene IPv6) y cambia el prefijo
# postgresql:// por postgresql+psycopg://  (la contraseña nunca va a GitHub)
DATABASE_URL=postgresql+psycopg://postgres.ndyfurszxacgzpaixxny:[PASSWORD]@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# Puntaje mínimo de similitud para aceptar un fragmento
SIMILARITY_THRESHOLD=0.5
